Cell[CellGroupData[{

Cell["BFB conditions", "Subsection",
 CellChangeTimes->{{3.962211783599872*^9, 3.96221182778589*^9}, {
  3.962211895375527*^9, 3.962211897307308*^9}, {3.9622120883150053`*^9, 
  3.962212088607562*^9}, {3.962255467961945*^9, 
  3.9622554706421747`*^9}},ExpressionUUID->"6de01aaf-ac03-4a10-8fc1-\
47eaf755e429"],

Cell[TextData[{
 "A randomly generated data set of potential couplings. To save computational \
time, the necessary BFB conditions are applied initially ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72c21801-bccd-4308-9849-bac2ecd38002"],
 " \[GreaterEqual] 0 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05276a2c-0a13-48e4-b9d7-e8327d0b4d9d"],
 " \[GreaterEqual] 0."
}], "Text",
 CellChangeTimes->{{3.960962879099701*^9, 3.960962883627397*^9}, {
  3.962254445564405*^9, 3.962254502287258*^9}, {3.962254561515017*^9, 
  3.962254594270364*^9}, {3.962254637002763*^9, 
  3.9622546474849377`*^9}},ExpressionUUID->"56ccf9ff-78f6-4b5b-90fb-\
bb9fb639a080"],

Cell[BoxData[
 RowBox[{
  RowBox[{"valLmdT", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], ",", "2"}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "4"}], "]"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      SuperscriptBox["10", "4"], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9606926220925703`*^9, 3.96069267361549*^9}, {
   3.9606927047844114`*^9, 3.9606927167281675`*^9}, {3.9606928786152067`*^9, 
   3.9606928788865786`*^9}, {3.9606979604122753`*^9, 
   3.9606979738533087`*^9}, {3.9607053476175933`*^9, 3.9607053498573427`*^9}, 
   3.960962888158654*^9, {3.960966861037868*^9, 3.960966873142613*^9}, 
   3.961063430465137*^9, 3.962248997508116*^9, {3.9622550157249813`*^9, 
   3.962255022093842*^9}},ExpressionUUID->"d6afe3e2-90da-426d-919e-\
a5b70ea66213"],

Cell["\<\
Define the list of scanning points, which may lie either along specific lines \
or on the surface.\
\>", "Text",
 CellChangeTimes->{{3.9615020936647367`*^9, 3.961502104248753*^9}, {
  3.9622548384640217`*^9, 
  3.962254927367897*^9}},ExpressionUUID->"2b4cf525-85e5-4f5b-be40-\
da5ac4dc74bb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgePoints", "=", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Join", "[", 
     RowBox[{"pointsExcep", ",", "\[Delta]\[Gamma]5\[Tau]2ListMagenta"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"edgePoints", "//", "Length"}]}], "Input",
 CellChangeTimes->{{3.96225217362311*^9, 3.962252179135833*^9}},
 CellLabel->
  "In[750]:=",ExpressionUUID->"8010ee2b-44a7-4057-b095-518a1049268e"],

Cell[BoxData["2004"], "Output",
 CellChangeTimes->{3.96225218628764*^9},
 CellLabel->
  "Out[751]=",ExpressionUUID->"fd4e6d11-0919-4086-b79e-bea5591bc7cc"]
}, Open  ]],

Cell[TextData[{
 "Perform global minimization of the potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5f71d802-5aa0-4843-a669-79938ded3ec1"],
 " under various boundary conditions for the fields."
}], "Text",
 CellChangeTimes->{{3.960962879099701*^9, 3.960962883627397*^9}, {
   3.961215494573948*^9, 3.961215499522202*^9}, {3.9612453850300922`*^9, 
   3.9612453927403584`*^9}, {3.962254657517717*^9, 3.9622547037569427`*^9}, 
   3.962254809083353*^9},ExpressionUUID->"ed4c78c7-545c-4077-8d35-\
2a56f47a5f5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"minTestList", "=", 
    RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"bndT", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "50", ",", "300", ",", 
          SuperscriptBox["10", "3"], ",", 
          SuperscriptBox["10", "5"]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"minPotVal", "=", 
          RowBox[{"MinimFunc4pletY0", "[", 
           RowBox[{
            RowBox[{"valLmdT", "[", 
             RowBox[{"[", "xx", "]"}], "]"}], ",", "bndT"}], "]"}]}], ")"}], "//",
         "Quiet"}], ";", "\[IndentingNewLine]", "minPotVal"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"xx", ",", "1", ",", 
        SuperscriptBox["10", "4"]}], "}"}]}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minTestList", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{"minTestList", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a_", "/;", 
        RowBox[{"a", "<", "0"}]}], ",", "_", ",", "_"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "Length"}]}], "Input",
