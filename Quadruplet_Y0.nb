Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "BFB4pletY0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BFB4pletY0", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"param1", ",", "_Real", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"param2", ",", "_Real", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"case", ",", "_Integer"}], "}"}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Delta]", ",", "\[Gamma]5", ",", "\[Beta]", ",", "\[Beta]2", ",", 
         "\[Delta]T", ",", "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3",
          ",", "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e", ",", 
         "\[Lambda]4a", ",", "\[Lambda]ea", ",", "cond1", ",", "cond2", ",", 
         "cond3", ",", 
         RowBox[{"test", "=", "False"}], ",", "term1", ",", "term2", ",", 
         "term3", ",", "term4", ",", 
         RowBox[{"left", "=", 
          RowBox[{"-", "1."}]}], ",", 
         RowBox[{"right", "=", "1."}], ",", "minim", ",", "\[Delta]m", ",", 
         "\[Gamma]5m", ",", 
         RowBox[{"tol", "=", 
          SuperscriptBox["10.", 
           RowBox[{"-", "6"}]]}], ",", 
         RowBox[{"tabl0", "=", 
          RowBox[{"Table", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"{", "6", "}"}]}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
           "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e"}], "}"}], "=", 
         "param1"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]4a", ",", "\[Lambda]ea"}], "}"}], "=", 
         RowBox[{"Abs", "/@", 
          RowBox[{"{", 
           RowBox[{"\[Lambda]4", ",", "\[Lambda]e"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"-", "BFB"}]}]}]}]}]}]}]}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"necessary", "--"}], "--"}], "--"}], "--"}]}], "-", 
          RowBox[{"--", 
           RowBox[{"--", "-"}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{"\[Lambda]1", ">=", "0"}], ",", 
            RowBox[{"\[Lambda]2", ">=", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"10", "*", "\[Lambda]2"}], "+", 
              RowBox[{"9", "*", "\[Lambda]5"}]}], ">=", "0"}]}], "]"}], ",", 
          RowBox[{"test", "=", "True"}], ",", 
          RowBox[{"Return", "[", "tabl0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Lambda]3", "-", 
              RowBox[{
               FractionBox["3", "4"], "*", "\[Lambda]4a"}], "+", 
              SqrtBox[
               RowBox[{"\[Lambda]1", "*", "\[Lambda]2"}]]}], ">=", "0"}], ",", 
            RowBox[{
             RowBox[{"\[Lambda]3", "-", 
              RowBox[{
               FractionBox["3", "2"], "*", "\[Lambda]ea"}], "+", 
              SqrtBox[
               RowBox[{"\[Lambda]1", "*", 
                RowBox[{"(", 
                 RowBox[{"\[Lambda]2", "+", 
                  RowBox[{
                   FractionBox["9", "10"], "*", "\[Lambda]5"}]}], ")"}]}]]}], 
             ">=", "0"}]}], "]"}], ",", 
          RowBox[{"test", "=", "True"}], ",", 
          RowBox[{"Return", "[", "tabl0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"case", "==", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "scan", " ", "through", " ", "the", " ", "list", " ", 
            "edgePoints"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
