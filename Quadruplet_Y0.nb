Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "MaxSolVal", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MaxSolVal", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]T_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Gamma]5T_", "?", "NumberQ"}]}], "}"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"surfCT", ",", "solvT", ",", "maxVal"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"surfCT", "=", 
         RowBox[{
          RowBox[{"surfC", "/.", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Delta]T", ",", "\[Gamma]5T"}], "}"}], ",", "50"}], 
              "]"}]}], "]"}]}], "//", "Expand"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solvT", "=", 
         RowBox[{"\[Tau]2", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"surfCT", "==", "0"}], "}"}], ",", "\[Tau]2", ",", 
            "Reals"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxVal", "=", 
         RowBox[{"N", "@", 
          RowBox[{"Max", "@", 
           RowBox[{"Cases", "[", 
            RowBox[{"solvT", ",", 
             RowBox[{"a_", "/;", 
              RowBox[{"0", "<=", "a", "<=", 
               RowBox[{"9", "/", "4"}]}]}]}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", "maxVal"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.962245949269638*^9, 3.962245955547703*^9}, {
