Cell[TextData[{
 "We can verify phase space points generated from fields by comparing \
parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Tau]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14016608-5b54-4e84-91ac-b162f85cfbb9"],
 " with the maximal solution ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Tau]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cd1031ed-7826-4cc5-8ed0-17661ac0b3ce"],
 " of the eq. surfC = 0, since the parameters \[Delta] and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29e0f983-d39f-44df-b160-4c96a174c769"],
 " satisfy the condition -9 + 20",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b3ffc3a-8f83-45b6-b9f8-c163b185694a"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"9", 
    SuperscriptBox["\[Delta]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0dbf5886-62a3-4adb-955a-8e2716894250"],
 " \[LessEqual] 0."
}], "Text",
 CellChangeTimes->{{3.9622472237663803`*^9, 3.962247228046023*^9}, {
   3.9622473010091333`*^9, 3.962247302251237*^9}, {3.9622473338570642`*^9, 
   3.962247383436625*^9}, {3.9622474750294533`*^9, 3.962247569698612*^9}, {
   3.962247840759697*^9, 3.9622479976754827`*^9}, 3.962248171876408*^9, {
   3.962248209469274*^9, 3.9622482098835278`*^9}, {3.962248299774478*^9, 
   3.9622483441839743`*^9}},ExpressionUUID->"411841e6-aedc-4f0e-879d-\
aedfd1f44431"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"listTMP", "=", "\[Delta]\[Gamma]5\[Tau]2ListC"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"And", "@@", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"And", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "9"}], "+", 
         RowBox[{"20", 
          RowBox[{"listTMP", "[", 
           RowBox[{"[", 
            RowBox[{"xx", ",", "2"}], "]"}], "]"}]}], "+", 
         RowBox[{"9", 
          SuperscriptBox[
