 RowBox[{
  RowBox[{"listTMP", "=", "\[Delta]\[Gamma]5\[Epsilon]2ListC"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"And", "@@", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"And", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
