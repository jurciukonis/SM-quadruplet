        RowBox[{"D", "[", 
         RowBox[{"AA", ",", "z"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"BB", ",", "x"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"BB", ",", "y"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"BB", ",", "z"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"CC", ",", "x"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"CC", ",", "y"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"CC", ",", "z"}], "]"}]}], "}"}]}], "}"}], "]"}], "//", 
   "FullSimplify"}]}]}], "Input",
