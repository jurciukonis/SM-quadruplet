2a56f47a5f5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"minTestList", "=", 
    RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"bndT", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "50", ",", "300", ",", 
          SuperscriptBox["10", "3"], ",", 
          SuperscriptBox["10", "5"]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"minPotVal", "=", 
          RowBox[{"MinimFunc4pletY32", "[", 
           RowBox[{
            RowBox[{"valLmdT", "[", 
             RowBox[{"[", "xx", "]"}], "]"}], ",", "bndT"}], "]"}]}], ")"}], "//",
         "Quiet"}], ";", "\[IndentingNewLine]", "minPotVal"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"xx", ",", "1", ",", 
        SuperscriptBox["10", "4"]}], "}"}]}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minTestList", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{"minTestList", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a_", "/;", 
        RowBox[{"a", "<", "0"}]}], ",", "_", ",", "_"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "Length"}]}], "Input",
