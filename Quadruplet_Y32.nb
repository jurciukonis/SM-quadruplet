      RowBox[{
       RowBox[{"4", " ", 
        SuperscriptBox["y", "3"]}], "+", 
       RowBox[{"y", " ", 
        RowBox[{"(", 
         RowBox[{"3", "-", 
          RowBox[{"11", " ", 
           SuperscriptBox["z", "2"]}]}], ")"}]}], "+", 
