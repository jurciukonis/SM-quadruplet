Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"AA", ",", "BB", ",", "CC"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
    "\[Delta]invXYZ", ",", "\[Gamma]5invXYZ", ",", "\[Epsilon]2invXYZ"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"detEq", "=", 
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"AA", ",", "x"}], "]"}], ",", 
        RowBox[{"D", "[", 
