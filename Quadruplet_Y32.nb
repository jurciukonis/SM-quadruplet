Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"FuncMin4pletY32", ",", "MinimizeSurf4pletY32"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FuncMin4pletY32", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]1_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]2_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]3_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]4_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]5_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Xi]_", "?", "NumberQ"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]T_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Gamma]5T_", "?", "NumberQ"}]}], "}"}], ",", 
      RowBox[{"case_", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "c4", ",", "c3", ",", "c2", ",", "c0", ",", "\[CapitalDelta]", ",", 
        "\[CapitalLambda]1", ",", "\[CapitalLambda]2", ",", "b", ",", "NN", 
        ",", 
        RowBox[{"test", "=", "False"}], ",", 
        RowBox[{"test2", "=", "False"}], ",", 
        RowBox[{"test3", "=", "False"}], ",", "surfC", ",", "surfCT", ",", 
        "solvT", ",", "max\[Epsilon]2"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "<=", "\[Delta]T", "<=", "1"}], ",", 
           RowBox[{"0", "<=", "\[Gamma]5T", "<=", 
            RowBox[{
             FractionBox["9", "20"], "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["\[Delta]T", "2"]}], ")"}]}]}]}], "]"}], ",", 
         RowBox[{"test", "=", "True"}], ",", 
         RowBox[{"Return", "[", 
          SuperscriptBox["10.", "10"], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"max\[Epsilon]2", "=", 
        RowBox[{"MaxSolVal", "[", 
         RowBox[{"{", 
          RowBox[{"\[Delta]T", ",", "\[Gamma]5T"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"c4", "=", 
        FractionBox["\[Lambda]1", "2"]}], ";", " ", 
       RowBox[{"c3", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Abs", "[", "\[Xi]", "]"}]}], "*", 
         SqrtBox["max\[Epsilon]2"]}]}], ";", " ", 
       RowBox[{"c2", "=", 
        RowBox[{"\[Lambda]3", "+", 
         RowBox[{
          FractionBox["3", "4"], "*", "\[Lambda]4", "*", "\[Delta]T"}]}]}], 
       ";", " ", 
       RowBox[{"c0", "=", 
        FractionBox[
         RowBox[{"\[Lambda]2", "+", 
          RowBox[{"2", "*", "\[Lambda]5", "*", "\[Gamma]5T"}]}], "2"]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"NN", "=", 
        FractionBox["c3", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["c4", "3"], "*", "c0"}], ")"}], 
          RowBox[{"1", "/", "4"}]]]}], ";", " ", 
       RowBox[{"b", "=", 
        FractionBox["c2", 
         SqrtBox[
          RowBox[{"c4", "*", "c0"}]]]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]", "=", 
        RowBox[{
         RowBox[{"4", "*", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["b", "2"], "+", "12"}], ")"}], "3"]}], "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"72", "*", "b"}], "-", 
            RowBox[{"2", "*", 
             SuperscriptBox["b", "3"]}], "-", 
            RowBox[{"27", "*", 
             SuperscriptBox["NN", "2"]}]}], ")"}], "2"]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"case", "==", "1"}], ",", " ", 
         RowBox[{"Return", "[", "\[CapitalDelta]", "]"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "<", "0"}], ",", 
            RowBox[{"Return", "[", "\[CapitalDelta]", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[CapitalLambda]1", "=", 
           RowBox[{
            SuperscriptBox["NN", "2"], "-", 
            RowBox[{"16", "*", 
             RowBox[{"(", 
              RowBox[{"b", "+", "2"}], ")"}]}], "-", 
            RowBox[{"16", "*", "NN"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"And", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "<=", "b", "<=", "6"}], ",", 
              RowBox[{"\[CapitalLambda]1", "<=", "0"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"test2", "=", "True"}], ";"}], ",", " ", 
            RowBox[{"test2", "=", "False"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Or", "[", 
             RowBox[{"test2", ",", 
              RowBox[{"b", ">", "6"}]}], "]"}], ",", 
            RowBox[{"test", "=", "True"}], ",", 
            RowBox[{
             RowBox[{"test", "=", "False"}], ";", " ", 
             RowBox[{"Return", "[", 
              RowBox[{"-", 
               SuperscriptBox["10.", "5"]}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalLambda]2", "=", 
           RowBox[{
            SuperscriptBox["NN", "2"], "-", 
            RowBox[{"16", "*", 
             RowBox[{"(", 
              RowBox[{"b", "+", "2"}], ")"}]}], "-", 
            RowBox[{"4", "*", "NN", "*", 
             FractionBox[
              RowBox[{"b", "+", "2"}], 
              SqrtBox[
               RowBox[{"b", "-", "2"}]]]}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Or", "[", 
             RowBox[{"test2", ",", 
              RowBox[{"\[CapitalLambda]2", "<=", "0"}]}], "]"}], ",", 
            RowBox[{"Return", "[", "\[CapitalDelta]", "]"}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"-", 
              SuperscriptBox["10.", "5"]}], "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MinimizeSurf4pletY32", "[", 
    RowBox[{"parameters_", ",", 
     RowBox[{"case_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Epsilon]", ",", "\[Epsilon]2", ",", "\[Delta]T", ",", "\[Lambda]1", 
       ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4", ",", 
       "\[Lambda]5", ",", "\[Lambda]4a", ",", "\[Xi]", ",", "\[Nu]a", ",", 
       "c4", ",", "c3", ",", "c2", ",", "c0", ",", "\[CapitalDelta]", ",", 
       "\[CapitalLambda]1", ",", "\[CapitalLambda]2", ",", "b", ",", "N", ",",
        "minFunc", ",", "minPotVal"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4",
          ",", "\[Lambda]5", ",", "\[Xi]"}], "}"}], "=", "parameters"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"test", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"test", "==", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"seed", "=", 
            RowBox[{"RandomInteger", "[", 
             SuperscriptBox["10", "4"], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"minPotVal", "=", 
            RowBox[{"TimeConstrained", "[", 
             RowBox[{
              RowBox[{"NMinimize", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"FuncMin4pletY32", "[", 
                   RowBox[{
                    RowBox[{"{", 
