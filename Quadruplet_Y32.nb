Cell[BoxData[{
 RowBox[{
  RowBox[{"stepT", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"DeleteDuplicates", "@", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"xx", ",", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "0.01", ",", "0.98", ",", "0.02"}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"5", "*", 
          SuperscriptBox["10.", 
           RowBox[{"-", "2"}]]}], ",", 
         SuperscriptBox["10.", 
          RowBox[{"-", "3"}]], ",", 
         SuperscriptBox["10.", 
          RowBox[{"-", "4"}]], ",", "0.99", ",", "0.995"}], "}"}]}], 
      "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layList2DPrec1", "=", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"solT", "=", 
       RowBox[{"\[Gamma]5", "/.", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"surfC", "==", "0"}], "&&", 
             RowBox[{"surfA", "<=", "0"}]}], ")"}], "/.", 
           RowBox[{"\[Epsilon]2", "->", 
            RowBox[{"Rationalize", "[", "xx", "]"}]}]}], ",", "\[Gamma]5"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"0.5", "<", "xx", "<", "0.9"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], ",", 
        RowBox[{"0.9", "<", "xx", "<", "1"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{"0.7", ",", "1"}], "}"}]}], ",", "True", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotT1", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"solT", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]", ",", "minT", ",", "maxT"}], "}"}], ",", 
         RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "30"}], ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"listT1", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{"plotT1", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"ReplacePart", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"-", "1"}], "->", "1"}]}], "]"}], "&"}], "/@", 
            RowBox[{"Position", "[", 
             RowBox[{"plotT1", ",", "Line"}], "]"}]}], ")"}]}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
       RowBox[{"MinMax", "@", 
        RowBox[{"listT1", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}]}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"xx", "<", "0.584428"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"minT2", "=", 
          RowBox[{"\[Delta]", "/.", 
           RowBox[{"N", "@", 
            RowBox[{"First", "[", 
             RowBox[{"Solve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"solT", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "==", 
                RowBox[{
                 FractionBox["9", "20"], " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   SuperscriptBox["\[Delta]", "2"]}], ")"}]}]}], ",", 
               "\[Delta]"}], "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"plotT2", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"solT", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Delta]", ",", "minT2", ",", "maxT"}], "}"}], ",", 
