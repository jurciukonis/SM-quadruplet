Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gb", "=", 
    RowBox[{"GroebnerBasis", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]invXYZ", "==", "k"}], ",", 
        RowBox[{"\[Gamma]5invXYZ", "==", "l"}], ",", 
        RowBox[{"\[Epsilon]2invXYZ", "==", "m"}], ",", 
        RowBox[{"detEq", "==", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "l", ",", "m"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{"MonomialOrder", "\[Rule]", "EliminationOrder"}]}], "]"}]}], 
   ";"}], "//", "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gb", "/.", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "l", ",", "m"}], "}"}], "->", 
     RowBox[{"{", 
      RowBox[{"\[Delta]", ",", "\[Gamma]5", ",", "\[Epsilon]2"}], "}"}]}], 
    "]"}]}], "//", "FullSimplify"}]}], "Input",
