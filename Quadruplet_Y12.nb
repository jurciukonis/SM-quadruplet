Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"PotFunc4pletY12", ",", "MinimFunc4pletY12"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PotFunc4pletY12", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"param1", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"param2", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
          "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e", ",", "c", ",", 
          "d", ",", "e", ",", "f", ",", "\[Kappa]"}], "}"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
            "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e"}], "}"}], "=", 
          "param1"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", "d", ",", "e", ",", "f", ",", "\[Kappa]"}], 
           "}"}], "=", "param2"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          FractionBox["\[Lambda]1", "2"], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["c", "2"], "+", 
              SuperscriptBox["d", "2"], "+", 
              SuperscriptBox["e", "2"], "+", 
              SuperscriptBox["f", "2"]}], ")"}], "2"], " ", "\[Lambda]2"}], 
          "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["c", "2"], "+", 
             SuperscriptBox["d", "2"], "+", 
             SuperscriptBox["e", "2"], "+", 
             SuperscriptBox["f", "2"]}], ")"}], " ", "\[Lambda]3"}], "+", 
          RowBox[{
           FractionBox["1", "4"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "3"}], " ", 
              SuperscriptBox["c", "2"]}], "-", 
             SuperscriptBox["d", "2"], "+", 
             SuperscriptBox["e", "2"], "+", 
             RowBox[{"3", " ", 
              SuperscriptBox["f", "2"]}]}], ")"}], " ", "\[Lambda]4"}], "+", 
          RowBox[{
           FractionBox["1", "5"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["d", "2"], "-", 
                 RowBox[{
                  SqrtBox["3"], " ", "c", " ", "e"}]}], ")"}], "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"d", " ", "e"}], "-", 
                RowBox[{"3", " ", "c", " ", "f"}]}], ")"}], "2"], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["e", "2"], "-", 
                 RowBox[{
                  SqrtBox["3"], " ", "d", " ", "f"}]}], ")"}], "2"]}]}], 
            ")"}], " ", "\[Lambda]5"}], "+", 
          RowBox[{
           SqrtBox[
            FractionBox["2", "5"]], " ", "\[Lambda]e", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             SuperscriptBox["e", "2"], "-", 
             RowBox[{
              SqrtBox["3"], " ", "d", " ", "f"}]}], "]"}], " ", 
           RowBox[{"Cos", "[", "\[Kappa]", "]"}]}]}]}]}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
      RowBox[{"RuntimeAttributes", "\[Rule]", 
       RowBox[{"{", "Listable", "}"}]}], ",", 
      RowBox[{"CompilationOptions", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<InlineExternalDefinitions\>\"", "\[Rule]", "True"}], 
        "}"}]}], ",", 
      RowBox[{"CompilationTarget", "\[Rule]", "compTarg"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MinimFunc4pletY12", "[", 
    RowBox[{"parameters_", ",", "bndT_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4", 
       ",", "\[Lambda]5", ",", "\[Lambda]e", ",", "minFunc", ",", "minPotVal",
        ",", "c", ",", "d", ",", "e", ",", "f", ",", "\[Kappa]", ",", 
       "parBounds", ",", "parRegion"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4",
          ",", "\[Lambda]5", ",", "\[Lambda]e"}], "}"}], "=", "parameters"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"parRegion", "=", 
       RowBox[{"{", 
        RowBox[{"c", ",", "d", ",", "e", ",", "f", ",", "\[Kappa]"}], "}"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"parBounds", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"bndT", "[", 
                  RowBox[{"[", "xx", "]"}], "]"}]}], "\[LessEqual]", "#", 
                "\[LessEqual]", 
                RowBox[{"bndT", "[", 
                 RowBox[{"[", "xx", "]"}], "]"}]}], ")"}], "&"}], "/@", 
             RowBox[{"parRegion", "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{"-", "2"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"0", "<=", "\[Kappa]", "<=", 
              RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"minPotVal", "=", 
          RowBox[{"NMinimize", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PotFunc4pletY12", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
                  "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e"}], "}"}],
                 ",", 
                RowBox[{"{", 
                 RowBox[{"c", ",", "d", ",", "e", ",", "f", ",", "\[Kappa]"}],
                  "}"}]}], "]"}], ",", "parBounds"}], "}"}], ",", "parRegion",
             ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<NelderMead\>\"", ",", 
               RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "1000"}], "}"}], "]"}]}]}], "}"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "minPotVal", "]"}], "<", "0"}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"minPotVal", "=", 
          RowBox[{"NMinimize", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PotFunc4pletY12", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
                  "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e"}], "}"}],
                 ",", 
                RowBox[{"{", 
                 RowBox[{"c", ",", "d", ",", "e", ",", "f", ",", "\[Kappa]"}],
                  "}"}]}], "]"}], ",", "parBounds"}], "}"}], ",", "parRegion",
             ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<DifferentialEvolution\>\"", ",", 
               RowBox[{"\"\<PostProcess\>\"", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"FindMinimum", ",", 
                  RowBox[{"Method", "\[Rule]", "\"\<PrincipalAxis\>\""}]}], 
                 "}"}]}], ",", 
               RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "1000"}], "}"}], "]"}]}], ",", 
               RowBox[{"(*", 
                RowBox[{
