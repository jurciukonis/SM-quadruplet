Cell[BoxData[{
 RowBox[{
  RowBox[{"stepT", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"DeleteDuplicates", "@", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"xx", ",", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "0.01", ",", "0.63", ",", "0.01"}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["10.", 
          RowBox[{"-", "5"}]], ",", "0.631", ",", "0.632"}], "}"}]}], 
      "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layList2DPrec1", "=", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"solT", "=", 
       RowBox[{"\[Gamma]5", "/.", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"surfC", "/.", 
                RowBox[{"\[Eta]2", "->", 
                 SuperscriptBox["\[Eta]", "2"]}]}], ")"}], "==", "0"}], "&&", 
             
             RowBox[{"surfA", "<=", "0"}]}], ")"}], "/.", 
           RowBox[{"\[Eta]", "->", 
            RowBox[{"Rationalize", "[", "xx", "]"}]}]}], ",", "\[Gamma]5"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"xx", ">=", "0.63"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{"0.3", ",", "0.4"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotT1", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"solT", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]", ",", "minT", ",", "maxT"}], "}"}], ",", 
         RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "30"}], ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"listT1", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{"plotT1", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"ReplacePart", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"-", "1"}], "->", "1"}]}], "]"}], "&"}], "/@", 
            RowBox[{"Position", "[", 
             RowBox[{"plotT1", ",", "Line"}], "]"}]}], ")"}]}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
       RowBox[{"MinMax", "@", 
        RowBox[{"listT1", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}]}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"xx", "<=", 
         FractionBox["3", 
          RowBox[{"2", " ", 
           SqrtBox["10"]}]]}], ",", " ", 
        RowBox[{
         RowBox[{"plotT2", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              FractionBox["9", "20"]}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               SuperscriptBox["\[Delta]", "2"]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Delta]", ",", "minT", ",", "maxT"}], "}"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], 
              ","}], "*)"}], 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"listT2", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Extract", "[", 
               RowBox[{"plotT2", ",", "#"}], "]"}], "&"}], "/@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ReplacePart", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{
                   RowBox[{"-", "1"}], "->", "1"}]}], "]"}], "&"}], "/@", 
               RowBox[{"Position", "[", 
                RowBox[{"plotT2", ",", "Line"}], "]"}]}], ")"}]}], ",", "1"}],
            "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"layTT", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"listT2", ",", "listT1"}], "]"}]}], ";"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"minT2", "=", 
          RowBox[{"\[Delta]", "/.", 
           RowBox[{"N", "@", 
            RowBox[{"First", "[", 
             RowBox[{"Solve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"solT", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "==", 
                RowBox[{
                 RowBox[{"-", 
