Cell["\<\
For larger dataset it is recommended to add some points from the surface\
\>", "Text",
 CellChangeTimes->{{3.970398749076584*^9, 3.970398770437611*^9}, {
  3.971926593048641*^9, 3.9719266009545097`*^9}, {3.9719267025669823`*^9, 
  3.9719267270937243`*^9}},ExpressionUUID->"6ecdf32b-3220-471d-b585-\
9a7ea7d3fbbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]\[Gamma]5\[Eta]2SurfPointsUp", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Delta]T", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], ";", " ", 
      RowBox[{"\[Gamma]5T", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"\[Delta]T", "<", 
          RowBox[{"1", "/", "3"}]}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{
             FractionBox["1", "10"], " ", 
             RowBox[{"(", 
              RowBox[{"5", "-", 
               SqrtBox[
                RowBox[{"7", "-", 
