Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"FuncMin4pletY12", ",", "MinimizeSurf4pletY12"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FuncMin4pletY12", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]1_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]2_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]3_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]4_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Lambda]5_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Epsilon]_", "?", "NumberQ"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]T_", "?", "NumberQ"}], ",", 
        RowBox[{"\[Gamma]5T_", "?", "NumberQ"}]}], "}"}], ",", 
      RowBox[{"case_", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "c4", ",", "c3", ",", "c2", ",", "c0", ",", "\[CapitalDelta]", ",", 
        "\[CapitalLambda]1", ",", "\[CapitalLambda]2", ",", "b", ",", "NN", 
        ",", 
        RowBox[{"test", "=", "False"}], ",", 
        RowBox[{"test2", "=", "False"}], ",", 
        RowBox[{"test3", "=", "False"}], ",", "surfC", ",", "surfCT", ",", 
        "solvT", ",", "max\[Chi]2"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"-", "BFB"}]}]}]}]}]}]}]}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"necessary", "--"}], "--"}], "--"}], "--"}]}], "-", 
        RowBox[{"--", 
         RowBox[{"--", "-"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{"\[Lambda]1", ">=", "0"}], ",", 
           RowBox[{"\[Lambda]2", ">=", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"10", "*", "\[Lambda]2"}], "+", 
             RowBox[{"9", "*", "\[Lambda]5"}]}], ">=", "0"}]}], "]"}], ",", 
         RowBox[{"test", "=", "True"}], ",", 
         RowBox[{"Return", "[", 
          SuperscriptBox["10.", "10"], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "<=", "\[Delta]T", "<=", "1"}], ",", 
           RowBox[{"0", "<=", "\[Gamma]5T", "<=", 
            RowBox[{
             FractionBox["9", "20"], "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["\[Delta]T", "2"]}], ")"}]}]}]}], "]"}], ",", 
         RowBox[{"test", "=", "True"}], ",", 
         RowBox[{"Return", "[", 
          SuperscriptBox["10.", "10"], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"max\[Chi]2", "=", 
        RowBox[{"MaxSolVal", "[", 
         RowBox[{"{", 
          RowBox[{"\[Delta]T", ",", "\[Gamma]5T"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"\[Lambda]3", "+", 
        RowBox[{
         FractionBox["3", "4"], "*", "\[Lambda]4", "*", "\[Delta]T"}], "-", 
        RowBox[{
         RowBox[{"Abs", "[", "\[Epsilon]", "]"}], "*", 
         SqrtBox["max\[Chi]2"]}], "+", 
        SqrtBox[
         RowBox[{"\[Lambda]1", "*", 
          RowBox[{"(", 
           RowBox[{"\[Lambda]2", "+", 
            RowBox[{"2", "*", "\[Lambda]5", "*", "\[Gamma]5T"}]}], 
           ")"}]}]]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MinimizeSurf4pletY12", "[", 
    RowBox[{"parameters_", ",", 
     RowBox[{"case_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Epsilon]", ",", "\[Epsilon]2", ",", "\[Delta]T", ",", "\[Lambda]1", 
       ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4", ",", 
       "\[Lambda]5", ",", "\[Lambda]4a", ",", "\[Chi]", ",", "\[Nu]a", ",", 
       "c4", ",", "c3", ",", "c2", ",", "c0", ",", "\[CapitalDelta]", ",", 
       "\[CapitalLambda]1", ",", "\[CapitalLambda]2", ",", "b", ",", "N", ",",
        "minFunc", ",", "minPotVal", ",", "seed", ",", "test"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4",
          ",", "\[Lambda]5", ",", "\[Chi]"}], "}"}], "=", "parameters"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"test", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"test", "==", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"seed", "=", 
            RowBox[{"RandomInteger", "[", 
             SuperscriptBox["10", "4"], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"minPotVal", "=", 
            RowBox[{"TimeConstrained", "[", 
             RowBox[{
              RowBox[{"NMinimize", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"FuncMin4pletY12", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
                    "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Chi]"}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], ",", 
                    "case"}], "]"}], ",", 
                  RowBox[{"0", "<=", "\[Gamma]5", "<=", 
                   RowBox[{
                    FractionBox["9", "20"], "*", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    SuperscriptBox["\[Delta]", "2"]}], ")"}]}]}], ",", 
                  RowBox[{
                   RowBox[{"-", "1"}], "<=", "\[Delta]", "<=", "1"}]}], "}"}],
                 ",", 
                RowBox[{"{", 
                 RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], ",", 
                RowBox[{"WorkingPrecision", "->", "50"}], ",", 
                RowBox[{"Method", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"\"\<NelderMead\>\"", ",", 
                   RowBox[{"RandomSeed", "\[Rule]", "seed"}]}], "}"}]}]}], 
               "]"}], ",", "5", ",", "$Failed"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"test", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"minPotVal", "==", "$Failed"}], ",", "False", ",", 
              "True"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}],
        "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"test", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"minPotVal", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], ","}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"test", "==", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"seed", "=", 
          RowBox[{"RandomInteger", "[", 
           SuperscriptBox["10", "4"], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"minPotVal", "=", 
          RowBox[{"TimeConstrained", "[", 
           RowBox[{
            RowBox[{"NMinimize", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"FuncMin4pletY12", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                   "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
                    "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Chi]"}], "}"}], 
                  ",", 
                  RowBox[{"{", 
                   RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], ",", 
                  "case"}], "]"}], ",", 
                RowBox[{"0", "<=", "\[Gamma]5", "<=", 
                 RowBox[{
                  FractionBox["9", "20"], "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    SuperscriptBox["\[Delta]", "2"]}], ")"}]}]}], ",", 
                RowBox[{
                 RowBox[{"-", "1"}], "<=", "\[Delta]", "<=", "1"}]}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "50"}], ",", 
              RowBox[{"Method", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"\"\<DifferentialEvolution\>\"", ",", 
                 RowBox[{"\"\<PostProcess\>\"", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{"FindMinimum", ",", 
                    RowBox[{"Method", "\[Rule]", "\"\<PrincipalAxis\>\""}]}], 
                   "}"}]}], ",", 
                 RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "seed"}]}], 
                RowBox[{"(*", 
                 RowBox[{",", 
                  RowBox[{"\"\<SearchPoints\>\"", "\[Rule]", "100"}], ","}], 
                 "*)"}], 
                RowBox[{"(*", 
                 RowBox[{",", 
                  RowBox[{"\"\<CrossProbability\>\"", "\[Rule]", 
                   RowBox[{"RandomReal", "[", 
                    RowBox[{"{", 
                    RowBox[{"0.5", ",", "0.9"}], "}"}], "]"}]}], ",", 
                  RowBox[{"\"\<ScalingFactor\>\"", "\[Rule]", 
                   RowBox[{"RandomReal", "[", 
                    RowBox[{"{", 
                    RowBox[{"0.5", ",", "0.9"}], "}"}], "]"}]}]}], "*)"}], 
                "}"}]}]}], "]"}], ",", "60", ",", "$Failed"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"test", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"minPotVal", "==", "$Failed"}], ",", "False", ",", 
            "True"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"]", ";"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "minPotVal"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
