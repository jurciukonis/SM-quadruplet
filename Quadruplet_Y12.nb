  3.9622554706421747`*^9}},ExpressionUUID->"6de01aaf-ac03-4a10-8fc1-\
47eaf755e429"],

Cell[TextData[{
 "A randomly generated data set of potential couplings. To save computational \
time, the necessary BFB conditions are applied initially ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72c21801-bccd-4308-9849-bac2ecd38002"],
 " \[GreaterEqual] 0 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05276a2c-0a13-48e4-b9d7-e8327d0b4d9d"],
 " \[GreaterEqual] 0."
}], "Text",
 CellChangeTimes->{{3.960962879099701*^9, 3.960962883627397*^9}, {
  3.962254445564405*^9, 3.962254502287258*^9}, {3.962254561515017*^9, 
  3.962254594270364*^9}, {3.962254637002763*^9, 
  3.9622546474849377`*^9}},ExpressionUUID->"56ccf9ff-78f6-4b5b-90fb-\
bb9fb639a080"],

Cell[BoxData[
 RowBox[{
  RowBox[{"valLmdT", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], ",", "2"}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "4"}], "]"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      SuperscriptBox["10", "4"], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9606926220925703`*^9, 3.96069267361549*^9}, {
   3.9606927047844114`*^9, 3.9606927167281675`*^9}, {3.9606928786152067`*^9, 
   3.9606928788865786`*^9}, {3.9606979604122753`*^9, 
   3.9606979738533087`*^9}, {3.9607053476175933`*^9, 3.9607053498573427`*^9}, 
   3.960962888158654*^9, {3.960966861037868*^9, 3.960966873142613*^9}, 
   3.961063430465137*^9, 3.962248997508116*^9, {3.9622550157249813`*^9, 
