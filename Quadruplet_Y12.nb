Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "MaxSolVal", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MaxSolVal", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]T_", "?", "NumericQ"}], ",", 
        RowBox[{"\[Gamma]5T_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"surf", ",", "solvT", ",", "maxVal"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "<=", "\[Delta]T", "<=", 
             RowBox[{"1", "/", "3"}]}], ",", 
            RowBox[{
             RowBox[{
              FractionBox["9", "80"], " ", 
              RowBox[{"(", 
               RowBox[{"3", "-", "\[Delta]T"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Delta]T"}], ")"}]}], "<=", "\[Gamma]5T", "<=", 
             RowBox[{
              FractionBox["9", "20"], " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox["\[Delta]T", "2"]}], ")"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"surf", "=", 
            RowBox[{
             RowBox[{"surfB", "/.", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], "->", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"\[Delta]T", ",", "\[Gamma]5T"}], "}"}], ",", 
                  "50"}], "]"}]}], "]"}]}], "//", "Expand"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"solvT", "=", 
            RowBox[{"\[Eta]2", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"surf", "==", "0"}], "}"}], ",", "\[Eta]2", ",", 
               "Reals"}], "]"}]}]}], ";"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"surf", "=", 
            RowBox[{
             RowBox[{"surfC", "/.", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], "->", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"\[Delta]T", ",", "\[Gamma]5T"}], "}"}], ",", 
                  "50"}], "]"}]}], "]"}]}], "//", "Expand"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"solvT", "=", 
            RowBox[{"\[Eta]2", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"surf", "==", "0"}], "}"}], ",", "\[Eta]2", ",", 
               "Reals"}], "]"}]}]}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxVal", "=", 
         RowBox[{"N", "@", 
          RowBox[{"Max", "@", 
           RowBox[{"Cases", "[", 
            RowBox[{"solvT", ",", 
             RowBox[{"a_", "/;", 
