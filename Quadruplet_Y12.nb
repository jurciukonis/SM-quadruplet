               RowBox[{"2", "/", "5"}]}]}]}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"\[Gamma]5T", "==", "0"}], ",", "0", ",", "maxVal"}], 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
