da5ac4dc74bb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgePoints", "=", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Join", "[", 
     RowBox[{
     "pointsExcep", ",", "\[Delta]\[Gamma]5\[Eta]2ListGreen", ",", 
      "\[Delta]\[Gamma]5\[Eta]2ListMagenta", ",", 
      "\[Delta]\[Gamma]5\[Eta]2ListOrange"}], "]"}]}]}], 
