Cell[TextData[{
 "We can verify phase space points generated from fields by comparing \
parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Eta]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14016608-5b54-4e84-91ac-b162f85cfbb9"],
 " with either the maximal solution ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Eta]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cd1031ed-7826-4cc5-8ed0-17661ac0b3ce"],
 " of the eq. surfC = 0 or solution of magenta line ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Eta]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64f3da3e-4c6d-4c7a-960c-220ef8e5847c"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox["9", "40"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "590be736-e961-4ac9-ba7a-04f7ac534e2f"],
 " (1+\[Delta]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[")", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14b6d12a-30e2-4dd7-94ca-5caf9767a52e"],
 " in the area of surface surfB = 0. In both cases the parameters \[Delta] \
and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29e0f983-d39f-44df-b160-4c96a174c769"],
 " satisfy the condition -9 + 20",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b3ffc3a-8f83-45b6-b9f8-c163b185694a"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"9", 
    SuperscriptBox["\[Delta]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0dbf5886-62a3-4adb-955a-8e2716894250"],
 " \[LessEqual] 0."
}], "Text",
