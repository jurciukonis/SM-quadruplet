           RowBox[{"[", 
            RowBox[{"xx", ",", "2"}], "]"}], "]"}]}], "+", 
         RowBox[{"9", 
          SuperscriptBox[
           RowBox[{"listTMP", "[", 
            RowBox[{"[", 
             RowBox[{"xx", ",", "1"}], "]"}], "]"}], "2"]}]}], "\[LessEqual]",
         "0"}], ",", 
       RowBox[{
        RowBox[{"(", 
