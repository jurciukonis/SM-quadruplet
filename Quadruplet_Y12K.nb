Cell[BoxData[
 RowBox[{
  FractionBox["4", "15"], " ", "z", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"9", " ", 
     SuperscriptBox["x", "3"], " ", "y"}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox["y", "2"], " ", "z", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SqrtBox["3"], " ", "y"}], "+", 
       RowBox[{"3", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"], "-", 
          SuperscriptBox["y", "2"], "-", 
          SuperscriptBox["z", "2"]}]]}]}], ")"}]}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"], " ", "z", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", 
        SqrtBox["3"], " ", "y"}], "-", 
       FractionBox[
        SuperscriptBox["y", "2"], 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"], "-", 
          SuperscriptBox["y", "2"], "-", 
          SuperscriptBox["z", "2"]}]]], "+", 
       RowBox[{"3", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"], "-", 
          SuperscriptBox["y", "2"], "-", 
          SuperscriptBox["z", "2"]}]]}]}], ")"}]}], "+", 
    RowBox[{"x", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "6"}], " ", 
        SuperscriptBox["y", "3"]}], "+", 
       RowBox[{"9", " ", "y", " ", 
        SuperscriptBox["z", "2"]}], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         SqrtBox["3"], " ", 
         SuperscriptBox["y", "2"], " ", 
         SuperscriptBox["z", "2"]}], 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"], "-", 
          SuperscriptBox["y", "2"], "-", 
          SuperscriptBox["z", "2"]}]]], "+", 
       RowBox[{"6", " ", 
        SqrtBox["3"], " ", 
        SuperscriptBox["z", "2"], " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"], "-", 
          SuperscriptBox["y", "2"], "-", 
          SuperscriptBox["z", "2"]}]]}]}], ")"}]}]}], ")"}]}]], "Output",
