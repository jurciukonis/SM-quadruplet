Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "MaxSolVal", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MaxSolVal", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Delta]T_", "?", "NumberQ"}], ",", 
      RowBox[{"\[Gamma]5T_", "?", "NumberQ"}]}], "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"surfCT", ",", "solvT", ",", "maxVal"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Or", "[", 
         RowBox[{
          RowBox[{"\[Delta]T", "==", 
           RowBox[{"-", "1"}]}], ",", 
          RowBox[{"\[Delta]T", "==", "1"}]}], "]"}], ",", 
        RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"surfCT", "=", 
       RowBox[{
        RowBox[{"surfC", "/.", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Delta]", ",", "\[Gamma]5"}], "}"}], "->", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Delta]T", ",", "\[Gamma]5T"}], "}"}], ",", "50"}], 
            "]"}]}], "]"}]}], "//", "Expand"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"solvT", "=", 
       RowBox[{"\[Epsilon]2", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"surfCT", "==", "0"}], "}"}], ",", "\[Epsilon]2", ",", 
          "Reals"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxVal", "=", 
       RowBox[{"N", "@", 
        RowBox[{"Max", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{"solvT", ",", 
           RowBox[{"a_", "/;", 
            RowBox[{"0", "<=", "a", "<=", 
             RowBox[{"1", "/", "4"}]}]}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "maxVal"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
