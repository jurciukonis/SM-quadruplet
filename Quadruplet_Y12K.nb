Cell[TextData[{
 "We can verify phase space points generated from fields by comparing \
parameter ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "84c6b984-4805-488e-9b94-b695d20f1939"],
 " with the maximal solution ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "1e53a851-92c0-4de8-8274-20a92cb335fa"],
 " of the eq. surfC = 0, since the parameters \[Delta] and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "5"], TraditionalForm]],ExpressionUUID->
  "7393cc3f-3ef6-482f-bba7-7c07f44b5794"],
 " satisfy the condition -9 + 20",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "5"], TraditionalForm]],ExpressionUUID->
  "281025bc-8473-4e48-9af8-529d3c2ee988"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"9", 
    SuperscriptBox["\[Delta]", "2"]}], TraditionalForm]],ExpressionUUID->
  "d4195863-f434-4519-b550-84c13a4ddc55"],
 " \[LessEqual] 0."
}], "Text",
 CellChangeTimes->{{3.9622472237663803`*^9, 3.962247228046023*^9}, {
   3.9622473010091333`*^9, 3.962247302251237*^9}, {3.9622473338570642`*^9, 
