Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "BFB4pletY12K", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BFB4pletY12K", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"param1", ",", "_Real", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"param2", ",", "_Real", ",", "2"}], "}"}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Delta]", ",", "\[Gamma]5", ",", "\[Beta]", ",", "\[Beta]2", ",", 
         "\[Delta]T", ",", "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3",
          ",", "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]4a", ",", 
         "\[Lambda]e", ",", "\[Lambda]ea", ",", "c4", ",", "c3", ",", "c2", 
         ",", "c0", ",", "\[CapitalDelta]", ",", "\[CapitalLambda]1", ",", 
         "\[CapitalLambda]2", ",", "b", ",", "N", ",", "cond0", ",", "cond1", 
         ",", "cond2", ",", "cond3", ",", 
         RowBox[{"test", "=", "False"}], ",", 
         RowBox[{"test2", "=", "False"}], ",", "term1", ",", "term2", ",", 
         "term3", ",", "term4", ",", 
         RowBox[{"tabl0", "=", 
          RowBox[{"Table", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"{", "6", "}"}]}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
           "\[Lambda]4", ",", "\[Lambda]5", ",", "\[Lambda]e"}], "}"}], "=", 
         "param1"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]4a", ",", "\[Lambda]ea"}], "}"}], "=", 
         RowBox[{"Abs", "/@", 
          RowBox[{"{", 
           RowBox[{"\[Lambda]4", ",", "\[Lambda]e"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"-", "necessary"}]}]}]}]}]}]}]}], " ", "and", " ", 
           "sufficient", " ", "BFB", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"conditions", "--"}], "--"}], "--"}], "--"}]}], "-", 
          RowBox[{"--", 
           RowBox[{"--", "-"}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{"\[Lambda]1", ">=", "0"}], ",", 
            RowBox[{"\[Lambda]2", ">=", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"10", "*", "\[Lambda]2"}], "+", 
              RowBox[{"9", "*", "\[Lambda]5"}]}], ">=", "0"}]}], "]"}], ",", 
          RowBox[{"test", "=", "True"}], ",", 
          RowBox[{"Return", "[", "tabl0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Lambda]3", "-", 
