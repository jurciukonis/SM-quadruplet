Cell[BoxData[{
 RowBox[{
  RowBox[{"stepT", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"DeleteDuplicates", "@", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"xx", ",", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "0.01", ",", "0.24", ",", "0.01"}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "*", 
          SuperscriptBox["10.", 
           RowBox[{"-", "3"}]]}], ",", 
         SuperscriptBox["10.", 
          RowBox[{"-", "3"}]], ",", 
         SuperscriptBox["10.", 
          RowBox[{"-", "4"}]], ",", "0.249"}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layList2DPrec1", "=", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"solT", "=", 
       RowBox[{"\[Gamma]5", "/.", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"surfC", "==", "0"}], "&&", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "9"}], "+", 
               RowBox[{"20", " ", "\[Gamma]5"}], "+", 
               RowBox[{"9", " ", 
                SuperscriptBox["\[Delta]", "2"]}]}], "<=", "0"}]}], ")"}], "/.", 
           RowBox[{"\[Epsilon]2", "->", 
            RowBox[{"Rationalize", "[", "xx", "]"}]}]}], ",", "\[Gamma]5"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"xx", ">=", "0.2"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0.6"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"minT", ",", "maxT"}], "}"}], "=", 
         RowBox[{"{", 
