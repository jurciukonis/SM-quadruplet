Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"AA", ",", "BB", ",", "CC"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
    "\[Delta]invXYZ", ",", "\[Gamma]5invXYZ", ",", "\[Epsilon]2invXYZ"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"detEq", "=", 
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"AA", ",", "x"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"AA", ",", "y"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"AA", ",", "z"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"BB", ",", "x"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"BB", ",", "y"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"BB", ",", "z"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"CC", ",", "x"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"CC", ",", "y"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"CC", ",", "z"}], "]"}]}], "}"}]}], "}"}], "]"}], "//", 
   "FullSimplify"}]}]}], "Input",
