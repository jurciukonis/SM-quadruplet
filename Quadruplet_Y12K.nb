b00806bd8cf3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Protect", "[", 
   RowBox[{
   "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "x", ",", "y", 
    ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FF1", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Abs", "[", "a", "]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"Abs", "[", "b", "]"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FF2", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Abs", "[", "c", "]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"Abs", "[", "d", "]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"Abs", "[", "e", "]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"Abs", "[", "f", "]"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FF5", "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      FractionBox["2", "5"]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["d", "2"]}], "+", 
       RowBox[{
        SqrtBox["3"], " ", "c", " ", "e"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          FractionBox["2", "5"]]}], " ", 
        SuperscriptBox[
         RowBox[{"Conjugate", "[", "d", "]"}], "2"]}], "+", 
       RowBox[{
        SqrtBox[
         FractionBox["6", "5"]], " ", 
        RowBox[{"Conjugate", "[", "c", "]"}], " ", 
        RowBox[{"Conjugate", "[", "e", "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     FractionBox["1", "5"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "d"}], " ", "e"}], "+", 
       RowBox[{"3", " ", "c", " ", "f"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Conjugate", "[", "d", "]"}]}], " ", 
        RowBox[{"Conjugate", "[", "e", "]"}]}], "+", 
       RowBox[{"3", " ", 
        RowBox[{"Conjugate", "[", "c", "]"}], " ", 
        RowBox[{"Conjugate", "[", "f", "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     SqrtBox[
      FractionBox["2", "5"]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["e", "2"]}], "+", 
       RowBox[{
        SqrtBox["3"], " ", "d", " ", "f"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          FractionBox["2", "5"]]}], " ", 
        SuperscriptBox[
         RowBox[{"Conjugate", "[", "e", "]"}], "2"]}], "+", 
       RowBox[{
        SqrtBox[
         FractionBox["6", "5"]], " ", 
        RowBox[{"Conjugate", "[", "d", "]"}], " ", 
        RowBox[{"Conjugate", "[", "f", "]"}]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FF4", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Abs", "[", "a", "]"}], "2"], "-", 
       SuperscriptBox[
        RowBox[{"Abs", "[", "b", "]"}], "2"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "c", "]"}], "2"]}], "2"], "+", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"Abs", "[", "d", "]"}], "2"], "2"], "-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"Abs", "[", "e", "]"}], "2"], "2"], "-", 
       FractionBox[
        RowBox[{"3", " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "f", "]"}], "2"]}], "2"]}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"a", " ", 
      RowBox[{"Conjugate", "[", "b", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SqrtBox[
          FractionBox["3", "2"]], " ", "d", " ", 
         RowBox[{"Conjugate", "[", "c", "]"}]}], "+", 
        RowBox[{
         SqrtBox["2"], " ", "e", " ", 
         RowBox[{"Conjugate", "[", "d", "]"}]}], "+", 
        RowBox[{
         SqrtBox[
          FractionBox["3", "2"]], " ", "f", " ", 
         RowBox[{"Conjugate", "[", "e", "]"}]}]}], ")"}]}], 
     SqrtBox["2"]], "+", 
    FractionBox[
     RowBox[{"b", " ", 
      RowBox[{"Conjugate", "[", "a", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SqrtBox[
          FractionBox["3", "2"]], " ", "c", " ", 
         RowBox[{"Conjugate", "[", "d", "]"}]}], "+", 
        RowBox[{
         SqrtBox["2"], " ", "d", " ", 
         RowBox[{"Conjugate", "[", "e", "]"}]}], "+", 
        RowBox[{
         SqrtBox[
          FractionBox["3", "2"]], " ", "e", " ", 
         RowBox[{"Conjugate", "[", "f", "]"}]}]}], ")"}]}], 
     SqrtBox["2"]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"I12K", "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SqrtBox["3"], " ", 
          RowBox[{"Conjugate", "[", "b", "]"}], " ", 
          RowBox[{"Conjugate", "[", "c", "]"}]}], "-", 
         RowBox[{
          RowBox[{"Conjugate", "[", "a", "]"}], " ", 
          RowBox[{"Conjugate", "[", "d", "]"}]}]}], ")"}]}], "+", 
      RowBox[{"2", " ", "a", " ", "b", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", "b", "]"}], " ", 
          RowBox[{"Conjugate", "[", "d", "]"}]}], "-", 
         RowBox[{
          RowBox[{"Conjugate", "[", "a", "]"}], " ", 
          RowBox[{"Conjugate", "[", "e", "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["b", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", "b", "]"}], " ", 
          RowBox[{"Conjugate", "[", "e", "]"}]}], "-", 
         RowBox[{
          SqrtBox["3"], " ", 
          RowBox[{"Conjugate", "[", "a", "]"}], " ", 
          RowBox[{"Conjugate", "[", "f", "]"}]}]}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.962164366134535*^9, 3.962164419128422*^9}, {
   3.962164584518179*^9, 3.962164641205933*^9}, {3.962165035950461*^9, 
   3.9621650370088253`*^9}, {3.962256967913348*^9, 3.9622570315905867`*^9}, 
   3.962274138078116*^9, 3.962274220651596*^9, {3.962278804962068*^9, 
   3.9622788133064203`*^9}},
 CellLabel->
  "In[484]:=",ExpressionUUID->"e3f83019-227d-425b-b2c1-ec4d28ad5a65"],

Cell["\<\
Definitions of phase space parameters assuming real fields, fixing gauge a = \
0, and redefining by parameters x, y, and z.\
\>", "Text",
 CellChangeTimes->{{3.962163422959626*^9, 3.962163427074648*^9}, {
  3.962163479516403*^9, 3.962163552088118*^9}, {3.962163582935234*^9, 
  3.96216359699958*^9}},ExpressionUUID->"bb0474d7-d4d9-4039-a67d-\
394cf582c15c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Delta]invC", ",", "\[Gamma]5invC", ",", "\[Epsilon]2invC"}], 
    "}"}], "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"4", "*", "FF4"}], 
       RowBox[{"3", "*", "FF1", "*", "FF2"}]], ",", 
      FractionBox["FF5", 
       SuperscriptBox["FF2", "2"]], ",", 
      FractionBox[
       RowBox[{"I12K", "*", 
        RowBox[{"Conjugate", "[", "I12K", "]"}]}], 
       RowBox[{
        SuperscriptBox["FF1", "3"], "*", "FF2"}]]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Delta]invR", ",", "\[Gamma]5invR", ",", "\[Epsilon]2invR"}], 
    "}"}], "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Delta]invC", ",", "\[Gamma]5invC", ",", "\[Epsilon]2invC"}], 
      "}"}], ",", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
        "}"}], ",", "Reals"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Delta]invG0", ",", "\[Gamma]5invG0", ",", "\[Epsilon]2invG0"}],
     "}"}], "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Delta]invR", ",", "\[Gamma]5invR", ",", "\[Epsilon]2invR"}],
        "}"}], "/.", 
      RowBox[{"{", 
       RowBox[{"a", "->", "0"}], "}"}]}], ",", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
        "}"}], ",", "Reals"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[Delta]invXYZ", ",", "\[Gamma]5invXYZ", ",", "\[Epsilon]2invXYZ"}], 
    "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["x", "2"]}], "-", 
      RowBox[{
       FractionBox["4", "3"], " ", 
       SuperscriptBox["y", "2"]}], "-", 
      RowBox[{
       FractionBox["2", "3"], " ", 
       SuperscriptBox["z", "2"]}]}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["2", "5"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SqrtBox["3"], " ", "x", " ", "z"}], "-", 
          SuperscriptBox["y", "2"]}], ")"}], "2"]}], "+", 
      RowBox[{
       FractionBox["2", "5"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"y", " ", 
           SqrtBox[
            RowBox[{"3", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"], "-", 
